<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry>
      <ID>100</ID>
      <Description>"Made by Squ1ggs"</Description>
      <Color>FF8000</Color>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
    <CheatEntry>
      <ID>99</ID>
      <Description>"For KINGDOM HEARTS Birth by Sleep FINAL MIX - Steam version (Global). Attach Cheat Engine to KINGDOM HEARTS Birth by Sleep FINAL MIX.exe. Does not work on the Xbox PC / Microsoft Store or Epic versions. Untick minigame values before you leave the minigame, or the game locks."</Description>
      <Color>FF8000</Color>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
    <CheatEntry>
      <ID>101</ID>
      <Description>"Back up your save first. Each save is one character (Terra, Ventus or Aqua) - values are for whoever you are playing. Never change unlabelled bytes - that can crash the game."</Description>
      <Color>0000FF</Color>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
    <CheatEntry>
      <ID>98</ID>
      <Description>"Always be on the pause menu when changing values or ticking scripts. Close and reopen the pause menu afterwards so the game shows the changes."</Description>
      <Color>00FFFF</Color>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
    <CheatEntry>
      <ID>1900</ID>
      <Description>"Combat cheats (tick to turn on, untick to turn off)"</Description>
      <Options moHideChildren="1" moAllowManualCollapseAndExpand="1" moManualExpandCollapse="1" />
      <Color>4080FF</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>1901</ID>
          <Description>"No command cooldowns"</Description>
          <Color>4080FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(bbsCool,KINGDOM HEARTS Birth by Sleep FINAL MIX.exe,F3 0F 11 43 64 72 72 8B 43 60)
alloc(bbsCoolMem,$100,bbsCool)
label(bbsCoolRet)
registersymbol(bbsCool)

bbsCoolMem:
  mov [rbx+64],(float)100
  jmp bbsCoolRet

bbsCool:
  jmp bbsCoolMem
bbsCoolRet:

[DISABLE]
bbsCool:
  db F3 0F 11 43 64

unregistersymbol(bbsCool)
dealloc(bbsCoolMem)</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1902</ID>
          <Description>"Infinite focus (FP) - shotlock gauge stays full"</Description>
          <Color>4080FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(bbsFP,KINGDOM HEARTS Birth by Sleep FINAL MIX.exe,F3 0F 10 5E 68 0F 2F F3)
alloc(bbsFPMem,$100,bbsFP)
label(bbsFPRet)
registersymbol(bbsFP)

bbsFPMem:
  mov [rsi+68],(float)100
  movss xmm3,[rsi+68]
  jmp bbsFPRet

bbsFP:
  jmp bbsFPMem
bbsFPRet:

[DISABLE]
bbsFP:
  db F3 0F 10 5E 68

unregistersymbol(bbsFP)
dealloc(bbsFPMem)</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1903</ID>
          <Description>"Quick command styles - style gauge fills instantly"</Description>
          <Color>4080FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(bbsStyle,KINGDOM HEARTS Birth by Sleep FINAL MIX.exe,F3 0F 11 8B 30 01 00 00 0F 28 74 24 30)
alloc(bbsStyleMem,$100,bbsStyle)
label(bbsStyleRet)
registersymbol(bbsStyle)

bbsStyleMem:
  mov [rbx+00000130],(float)200
  jmp bbsStyleRet

bbsStyle:
  jmp bbsStyleMem
  nop 3
bbsStyleRet:

[DISABLE]
bbsStyle:
  db F3 0F 11 8B 30 01 00 00

unregistersymbol(bbsStyle)
dealloc(bbsStyleMem)</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1904</ID>
          <Description>"Player HP - tick this, then use the entries below (values show once you are in a fight or walking around)"</Description>
          <Options moHideChildren="1" />
          <Color>4080FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(bbsHP,KINGDOM HEARTS Birth by Sleep FINAL MIX.exe,0F BF 8F A0 04 00 00 48 8B E8)
alloc(bbsHPMem,$100,bbsHP)
label(bbsHPRet)
label(bbsHPPtr)
label(bbsInfHP)
registersymbol(bbsHP)
registersymbol(bbsHPPtr)
registersymbol(bbsInfHP)

bbsHPMem:
  mov [bbsHPPtr],rdi
  cmp byte ptr [bbsInfHP],0
  je @f
  push rax
  movzx eax,word ptr [rdi+000004A2]
  mov [rdi+000004A0],ax
  pop rax
@@:
  movsx ecx,word ptr [rdi+000004A0]
  jmp bbsHPRet

bbsHPPtr:
  dq 0
bbsInfHP:
  db 0

bbsHP:
  jmp bbsHPMem
  nop 2
bbsHPRet:

[DISABLE]
bbsHP:
  db 0F BF 8F A0 04 00 00

unregistersymbol(bbsHP)
unregistersymbol(bbsHPPtr)
unregistersymbol(bbsInfHP)
dealloc(bbsHPMem)</AssemblerScript>

    <CheatEntry>
      <ID>103</ID>
      <Description>"Finish Commands - list for the character you are playing. Other characters' finishers can show as invisible (no name or icon) in the menu, but they still work."</Description>
      <Options moHideChildren="1" moAllowManualCollapseAndExpand="1" moManualExpandCollapse="1" />
      <Color>FF00FF</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>206</ID>
          <Description>"Activate every unlocked finisher and fill its XP to max - tick once"</Description>
          <Color>40D040</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local list = getAddress('"KINGDOM HEARTS Birth by Sleep FINAL MIX.exe"+10FA5EB4')
local cmds = getAddress('"KINGDOM HEARTS Birth by Sleep FINAL MIX.exe"+811080')
for slot = 0, 15 do
  local e = list + slot * 8
  local id = readSmallInteger(e)
  local status = readSmallInteger(e + 2)
  if id &gt; 0 and id &lt; 200 and (status == 1 or status == 2) then
    writeSmallInteger(e + 2, 2)
    local need = readSmallInteger(cmds + id * 30 + 6)
    if readInteger(e + 4) &lt; need then writeInteger(e + 4, need) end
  end
end
{$asm}

[DISABLE]</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>210</ID>
          <Description>"Unlock EVERY finisher for the character you are playing (also activates them and fills XP) - back up your save, tick once"</Description>
          <Color>40D040</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local list = getAddress('"KINGDOM HEARTS Birth by Sleep FINAL MIX.exe"+10FA5EB4')
local tree = getAddress('"KINGDOM HEARTS Birth by Sleep FINAL MIX.exe"+821E78')
local cmds = getAddress('"KINGDOM HEARTS Birth by Sleep FINAL MIX.exe"+811080')
local who = ({[61] = 0, [62] = 1, [63] = 2})[readSmallInteger(list)]
if who == nil then
  showMessage('Could not tell which character is loaded. Load a save first, then tick this again.')
  return
end
for slot = 0, 15 do
  local id = readSmallInteger(tree + who * 32 + slot * 2)
  if id &gt; 0 and id &lt; 200 then
    local e = list + slot * 8
    local current = readSmallInteger(e)
    if current == 0 or current == id then
      writeSmallInteger(e, id)
      writeSmallInteger(e + 2, 2)
      local need = readSmallInteger(cmds + id * 30 + 6)
      if readInteger(e + 4) &lt; need then writeInteger(e + 4, need) end
    end
  end
end
{$asm}

[DISABLE]</AssemblerScript>
        </CheatEntry>

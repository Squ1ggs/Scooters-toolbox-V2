      <CheatEntries>
        <CheatEntry>
          <ID>301</ID>
          <Description>"Give every ability at max level (leaves Zero EXP alone) - back up your save, tick once"</Description>
          <Color>40D040</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local first = getAddress('"KINGDOM HEARTS Birth by Sleep FINAL MIX.exe"+10FA55D4')
local maxLevel = {5,3,3,5,3,0,3,3,3,3,3,5,5,2,2,3,3,2,2,2,2,1,1,1,1,1,1,1,1,1}
for i = 1, 30 do
  local m = maxLevel[i]
  if m &gt; 0 then
    writeInteger(first + (i - 1) * 4, 0x1FE00 | (m &lt;&lt; 6) | m)
  end
end
{$asm}

[DISABLE]</AssemblerScript>

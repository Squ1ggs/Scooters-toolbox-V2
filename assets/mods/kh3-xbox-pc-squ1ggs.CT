        <CheatEntry>
          <ID>10685</ID>
          <Description>"Infinite Gummi Ship HP"</Description>
          <Color>0080D0</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local function kh3save()
  local eng = readQword(getAddress('&quot;KINGDOM HEARTS III.exe&quot;+99B1860'))
  if not eng or eng == 0 then return nil end
  local gi = readQword(eng + 0xE30)
  if not gi or gi == 0 then return nil end
  return gi + 0x8630
end
local save = kh3save()
if not save then showMessage('Load your save first, then tick this again.') return end
local function kh3equipped()
  local base = {[0] = 0, [1] = 0, [2] = 16, [3] = 24, [4] = 124, [5] = 224, [6] = 424, [8] = 588}
  local eq = {}
  for c = 0, 15 do
    local s = readBytes(save + 0x1880 + c * 0x9C0 + 0x80, 27 * 8, true)
    if s then
      for k = 0, 26 do
        local id, ty = s[k * 8 + 1], s[k * 8 + 2]
        if (id ~= 0 or ty ~= 0) and base[ty] then
          local inv = base[ty] + id
          eq[inv] = (eq[inv] or 0) + 1
        end
      end
    end
  end
  return eq
end
local function kh3give(ids, max)
  local eq = kh3equipped()
  for _, id in ipairs(ids) do
    local a = save + 0x8F4 + id * 2
    local want = max - (eq[id] or 0)
    if want &gt; 0 and readBytes(a, 1) &lt; want then writeBytes(a, want, (readBytes(a + 1, 1) or 0) | 3) end
  end
end
local function kh3pawn()
  local eng = readQword(getAddress('&quot;KINGDOM HEARTS III.exe&quot;+99B1860'))
  if not eng or eng == 0 then return nil end
  local gi = readQword(eng + 0xE30)
  if not gi or gi == 0 then return nil end
  local lpa = readQword(gi + 0x50)
  if not lpa or lpa == 0 then return nil end
  local lp = readQword(lpa)
  if not lp or lp == 0 then return nil end
  local pc = readQword(lp + 0x48)
  if not pc or pc == 0 then return nil end
  local p = readQword(pc + 0x3E8)
  if not p or p == 0 then return nil end
  return p
end
kh3Timers = kh3Timers or {}
if kh3Timers.GumiHp then kh3Timers.GumiHp.destroy() end
local st = {}
local function kh3gumirow(p)
  local ps = readQword(p + 0x758)
  if not ps or ps &lt; 0x10000 then return nil end
  local dt = readQword(ps + 0x48)
  if not dt or dt &lt; 0x10000 or readInteger(dt + 0x50) ~= 1 then return nil end
  local data = readQword(dt + 0x48)
  if not data or data &lt; 0x10000 then return nil end
  local row = readQword(data + 8)
  if not row or row &lt; 0x10000 then return nil end
  local hp, spd = readFloat(row + 8), readFloat(row + 0x14)
  if not hp or not spd or hp &lt; 100 or hp &gt; 1000000 or spd &lt; 100 or spd &gt; 100000 then return nil end
  return row
end
local t = createTimer(nil, false)
t.Interval = 100
t.OnTimer = function()
  pcall(function()
    local p = kh3pawn()
    if not p then return end
    if kh3gumirow(p) then
      local mx = readInteger(p + 0x518) or 0
      if mx &gt; 0 and mx &lt; 1000000 and (readInteger(p + 0x510) or 0) &lt; mx then writeInteger(p + 0x510, mx) end
    end
  end)
end
t.Enabled = true
kh3Timers.GumiHp = t
kh3State_GumiHp = st
{$asm}


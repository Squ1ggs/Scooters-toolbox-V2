    <CheatEntry>
      <ID>10897</ID>
      <Description>"Fixes - only if something looks wrong"</Description>
      <Options moHideChildren="1" moManualExpandCollapse="1" moAllowManualCollapseAndExpand="1"/>
      <Color>808080</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>10898</ID>
          <Description>"Update magic list (after picking spell levels by hand, or if the magic menu looks broken)"</Description>
          <Color>808080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local function kh3save()
  local eng = readQword(getAddress('&quot;KINGDOM HEARTS III.exe&quot;+99B1860'))
  if not eng or eng == 0 then return nil end
  local gi = readQword(eng + 0xE30)
  if not gi or gi == 0 then return nil end
  return gi + 0x8630
end
local save = kh3save()
if not save then showMessage('Load your save first, then tick this again.') return end
local function kh3equipped()
  local base = {[0] = 0, [1] = 0, [2] = 16, [3] = 24, [4] = 124, [5] = 224, [6] = 424, [8] = 588}
  local eq = {}
  for c = 0, 15 do
    local s = readBytes(save + 0x1880 + c * 0x9C0 + 0x80, 27 * 8, true)
    if s then
      for k = 0, 26 do
        local id, ty = s[k * 8 + 1], s[k * 8 + 2]
        if (id ~= 0 or ty ~= 0) and base[ty] then
          local inv = base[ty] + id
          eq[inv] = (eq[inv] or 0) + 1
        end
      end
    end
  end
  return eq
end
local function kh3give(ids, max)
  local eq = kh3equipped()
  for _, id in ipairs(ids) do
    local a = save + 0x8F4 + id * 2
    local want = max - (eq[id] or 0)
    if want &gt; 0 and readBytes(a, 1) &lt; want then writeBytes(a, want, (readBytes(a + 1, 1) or 0) | 3) end
  end
end
local lv = save + 0x1880 + 0x960 + 0x18
local m = save + 0xBF50
local order, seen = {}, {}
for i = 0, 5 do
  local v = readInteger(m + i * 4) or 0
  local f = (v - 29) // 4
  if v &gt;= 29 and v &lt;= 52 and not seen[f] then seen[f] = true order[#order + 1] = f end
end
for f = 0, 5 do if not seen[f] then order[#order + 1] = f end end
local n = 0
for _, f in ipairs(order) do
  local l = readBytes(lv + f, 1) or 0
  if l &gt; 3 then l = 3 end
  if l &gt; 0 then writeInteger(m + n * 4, 29 + f * 4 + l - 1) n = n + 1 end
end
for i = n, 5 do writeInteger(m + i * 4, 0) end
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
{$asm}
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>10899</ID>
          <Description>"Items not showing - marks every item you have as obtained"</Description>
          <Color>808080</Color>
          <VariableType>Auto Assembler Script</VariableType>

    <CheatEntry>
      <ID>10007</ID>
      <Description>"MAX ALL ITEMS - 80 of every item, armor, accessory and synthesis material, plus every keyblade, staff and shield (80 leaves room so chests still give items)"</Description>
      <Color>2020FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local function kh3save()
  local eng = readQword(getAddress('&quot;KINGDOM HEARTS III.exe&quot;+99B1860'))
  if not eng or eng == 0 then return nil end
  local gi = readQword(eng + 0xE30)
  if not gi or gi == 0 then return nil end
  return gi + 0x8630
end
local save = kh3save()
if not save then showMessage('Load your save first, then tick this again.') return end
local function kh3equipped()
  local base = {[0] = 0, [1] = 0, [2] = 16, [3] = 24, [4] = 124, [5] = 224, [6] = 424, [8] = 588}
  local eq = {}
  for c = 0, 15 do
    local s = readBytes(save + 0x1880 + c * 0x9C0 + 0x80, 27 * 8, true)
    if s then
      for k = 0, 26 do
        local id, ty = s[k * 8 + 1], s[k * 8 + 2]
        if (id ~= 0 or ty ~= 0) and base[ty] then
          local inv = base[ty] + id
          eq[inv] = (eq[inv] or 0) + 1
        end
      end
    end
  end
  return eq
end
local function kh3give(ids, max)
  local eq = kh3equipped()
  for _, id in ipairs(ids) do
    local a = save + 0x8F4 + id * 2
    local want = max - (eq[id] or 0)
    if want &gt; 0 and readBytes(a, 1) &lt; want then writeBytes(a, want, (readBytes(a + 1, 1) or 0) | 3) end
  end
end
kh3AllInv = readBytes(save + 0x8F4, 0x800, true)
kh3AllMat = readBytes(save + 0x165E, 200, true)
kh3give({0x1, 0x2, 0x3, 0x4, 0x5, 0x6, 0x7, 0x8, 0x9, 0xA, 0xB, 0x11, 0x12, 0x13, 0x14, 0x15, 0x1A9, 0x1AA, 0x1AB, 0x1AC, 0x1AD, 0x1AE, 0x1AF, 0x1B0, 0x1B1, 0x1B2, 0x1B3, 0x1B4, 0x1B5, 0x1B6, 0x1B7, 0x1B8, 0x1B9, 0x1BA, 0x1BB, 0x1BC, 0x1BD, 0x1BE, 0x1BF, 0x1C0, 0x1C1, 0x1C2, 0x1C3, 0x1C4, 0x1C5, 0x1C6, 0x1C7, 0x1C8, 0x1C9, 0x1CA, 0x1CB, 0x1CC, 0x1CD, 0x1CE, 0x1CF, 0x1D0, 0x1D1, 0x1D2, 0x1D3, 0x1D4, 0x1D5, 0x1D6, 0x1D7, 0x1D8, 0x1D9, 0x1DA, 0x1DB, 0x1DC, 0x1DD, 0x1DE, 0x1DF, 0x1E0, 0x24D, 0x24E, 0x24F, 0x250, 0x251, 0x252, 0x253, 0x254, 0x255, 0x256, 0x257, 0x258, 0x259, 0x25A, 0x25B, 0x25C, 0x25D, 0x25E, 0x25F, 0x260, 0x261, 0x262, 0x263, 0x264, 0x265, 0x266, 0x267, 0x268, 0x269, 0x26A, 0x26B, 0x26C, 0x26D, 0x26E, 0x26F, 0x270, 0x271, 0x272, 0x273, 0x274, 0x275, 0x276, 0x277, 0x278, 0x279, 0x27A, 0x27B, 0x27C, 0x27D, 0x27E, 0x27F, 0x280, 0x281, 0x282, 0x283, 0x284, 0x285, 0x286, 0x287}, 80)

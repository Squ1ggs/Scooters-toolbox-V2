    <CheatEntry>
      <ID>10834</ID>
      <Description>"Equipment slots per character (up to 8 each)"</Description>
      <Options moHideChildren="1" moManualExpandCollapse="1" moAllowManualCollapseAndExpand="1"/>
      <Color>00A0A0</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
    <CheatEntry>
      <ID>10835</ID>
      <Description>"Change a count, then tick &quot;Apply slot counts&quot; below. Lowering a count puts anything in the removed slots back in your stock."</Description>
      <Color>0060C0</Color>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
        <CheatEntry>
          <ID>10836</ID>
          <Description>"Apply slot counts"</Description>
          <Color>00A0A0</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local function kh3save()
  local eng = readQword(getAddress('&quot;KINGDOM HEARTS III.exe&quot;+99B1860'))
  if not eng or eng == 0 then return nil end
  local gi = readQword(eng + 0xE30)
  if not gi or gi == 0 then return nil end
  return gi + 0x8630
end
local save = kh3save()
if not save then showMessage('Load your save first, then tick this again.') return end
local function kh3equipped()
  local base = {[0] = 0, [1] = 0, [2] = 16, [3] = 24, [4] = 124, [5] = 224, [6] = 424, [8] = 588}
  local eq = {}
  for c = 0, 15 do
    local s = readBytes(save + 0x1880 + c * 0x9C0 + 0x80, 27 * 8, true)
    if s then
      for k = 0, 26 do
        local id, ty = s[k * 8 + 1], s[k * 8 + 2]
        if (id ~= 0 or ty ~= 0) and base[ty] then
          local inv = base[ty] + id
          eq[inv] = (eq[inv] or 0) + 1
        end
      end
    end
  end
  return eq
end
local function kh3give(ids, max)
  local eq = kh3equipped()
  for _, id in ipairs(ids) do
    local a = save + 0x8F4 + id * 2
    local want = max - (eq[id] or 0)
    if want &gt; 0 and readBytes(a, 1) &lt; want then writeBytes(a, want, (readBytes(a + 1, 1) or 0) | 3) end
  end
end
local kinds = {{0x03, 0x98}, {0x04, 0xD8}, {0x05, 0x118}}
local base = {[0] = 0, [1] = 0, [2] = 16, [3] = 24, [4] = 124, [5] = 224, [6] = 424, [8] = 588}
local function kh3slots(c, kind, n)
  local ch = save + 0x1880 + c * 0x9C0
  local k = kinds[kind]
  if n &lt; 0 then n = 0 end
  if n &gt; 8 then n = 8 end
  writeBytes(ch + k[1], n)
  for s = 0, 7 do
    local a = ch + k[2] + s * 8
    if s &lt; n then
      writeBytes(a + 4, 1)
    else
      local id, ty = readBytes(a, 1), readBytes(a + 1, 1)
      if (id ~= 0 or ty ~= 0) and base[ty] then
        local inv = save + 0x8F4 + (base[ty] + id) * 2
        writeBytes(inv, math.min((readBytes(inv, 1) or 0) + 1, 99))
      end
      writeBytes(a, 0, 0, 0, 0, 0, 0, 0, 0)
    end
  end
end
for c = 0, 14 do
  local ch = save + 0x1880 + c * 0x9C0
  for kind = 1, 3 do kh3slots(c, kind, readBytes(ch + kinds[kind][1], 1) or 0) end
end
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
{$asm}
</AssemblerScript>
        </CheatEntry>

    <CheatEntry>
      <ID>10003</ID>
      <Description>"Unticking undoes a change in the running game. Anything you save in game while it is ticked stays in that save file."</Description>
      <Color>0060C0</Color>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>

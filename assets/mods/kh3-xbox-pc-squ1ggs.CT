      <ID>10202</ID>
      <Description>"Items - give some or set counts (reopen the menu to see changes)"</Description>
      <Options moHideChildren="1" moManualExpandCollapse="1" moAllowManualCollapseAndExpand="1"/>
      <Color>0080D0</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>10203</ID>
          <Description>"Give 80 of every recovery item, boost, snack and food"</Description>
          <Color>0080D0</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local function kh3save()
  local eng = readQword(getAddress('&quot;KINGDOM HEARTS III.exe&quot;+99B1860'))
  if not eng or eng == 0 then return nil end
  local gi = readQword(eng + 0xE30)
  if not gi or gi == 0 then return nil end
  return gi + 0x8630
end
local save = kh3save()
if not save then showMessage('Load your save first, then tick this again.') return end
local function kh3equipped()
  local base = {[0] = 0, [1] = 0, [2] = 16, [3] = 24, [4] = 124, [5] = 224, [6] = 424, [8] = 588}
  local eq = {}
  for c = 0, 15 do
    local s = readBytes(save + 0x1880 + c * 0x9C0 + 0x80, 27 * 8, true)
    if s then
      for k = 0, 26 do
        local id, ty = s[k * 8 + 1], s[k * 8 + 2]
        if (id ~= 0 or ty ~= 0) and base[ty] then
          local inv = base[ty] + id
          eq[inv] = (eq[inv] or 0) + 1
        end
      end
    end
  end
  return eq
end
local function kh3give(ids, max)
  local eq = kh3equipped()
  for _, id in ipairs(ids) do
    local a = save + 0x8F4 + id * 2
    local want = max - (eq[id] or 0)
    if want &gt; 0 and readBytes(a, 1) &lt; want then writeBytes(a, want, (readBytes(a + 1, 1) or 0) | 3) end
  end
end
kh3ItemBackup = readBytes(save + 0x8F4, 0x800, true)

    <CheatEntry>
      <ID>172</ID>
      <Description>"Items &amp; Materials (51 item slots - counts up to 50 so chests can still be opened. Never have more than 9 materials or the meld menu crashes)"</Description>
      <Options moHideChildren="1" moAllowManualCollapseAndExpand="1" moManualExpandCollapse="1" />
      <Color>D0D000</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>850</ID>
          <Description>"Give 50 of all 9 crystals (7 crystals, Chaos Crystal, Secret Gem) - also removes fake materials (ores, flavours) because the meld menu crashes with more than 9 materials. Tick once."</Description>
          <Color>40D040</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local first = getAddress('"KINGDOM HEARTS Birth by Sleep FINAL MIX.exe"+111B4E6E')
local real = {0x3200, 0x3202, 0x3204, 0x3206, 0x3208, 0x320A, 0x320C, 0x320E, 0x320F}
local isReal = {}
for _, id in ipairs(real) do isReal[id] = true end
local count, extra, order = {}, {}, {}
for i = 0, 50 do
  local e = first + i * 4
  local id = readSmallInteger(e)
  if id ~= 0 and (id &lt; 0x3200 or id &gt; 0x32FF or isReal[id]) then
    if count[id] == nil then
      order[#order + 1] = id
      count[id] = readBytes(e + 2)
      extra[id] = readBytes(e + 3)
    else
      count[id] = math.max(count[id], readBytes(e + 2))
    end
  end
end
local skipped = 0
for _, id in ipairs(real) do
  if count[id] ~= nil then
    count[id] = 50
  elseif #order &lt; 51 then
    order[#order + 1] = id
    count[id] = 50
    extra[id] = 0
  else
    skipped = skipped + 1
  end
end
table.sort(order)
local empty = 51 - #order
for i = 0, 50 do
  local e = first + i * 4
  if i &lt; empty then
    writeSmallInteger(e, 0)
    writeBytes(e + 2, 0, 0)
  else
    local id = order[i - empty + 1]
    writeSmallInteger(e, id)
    writeBytes(e + 2, count[id], extra[id])
  end
end
if skipped &gt; 0 then
  showMessage('The game only holds 51 different items. ' .. skipped .. ' crystals did not fit - use or sell some items, then tick this again.')
end
{$asm}

[DISABLE]</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>851</ID>
          <Description>"Set every item you own to 50 (stops at 50 so chests can still be opened) - tick once"</Description>
          <Color>40D040</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local first = getAddress('"KINGDOM HEARTS Birth by Sleep FINAL MIX.exe"+111B4E6E')
for i = 0, 50 do
  local e = first + i * 4
  if readSmallInteger(e) ~= 0 then writeBytes(e + 2, 50) end
end
{$asm}

[DISABLE]</AssemblerScript>
        </CheatEntry>

    <CheatEntry>
      <ID>500</ID>
      <Description>"Battle Commands (your command stock - for the character you are playing)"</Description>
      <Options moHideChildren="1" moAllowManualCollapseAndExpand="1" moManualExpandCollapse="1" />
      <Color>FF80FF</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>501</ID>
          <Description>"Max level every command you own - also puts any level that is too high back to the max, and leaves item counts alone (back up your save, tick once, then open and close the pause menu)"</Description>
          <Color>40D040</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local stock = getAddress('"KINGDOM HEARTS Birth by Sleep FINAL MIX.exe"+111B5048')
local data = getAddress('"KINGDOM HEARTS Birth by Sleep FINAL MIX.exe"+A07020')
for i = 0, 568 do
  local e = stock + i * 10
  local id = readSmallInteger(e)
  if id &gt; 0 and id &lt; 452 and (id &lt; 188 or id &gt; 210) then
    local d = data + id * 30
    local maxLevel = readBytes(d + 5)
    local level = readBytes(e + 2)
    if level &gt; maxLevel then
      writeBytes(e + 2, maxLevel)
      if maxLevel == 0 then writeSmallInteger(e + 4, 0) end
    elseif maxLevel &gt; 1 and level &gt; 0 and level &lt; maxLevel then
      local base = readSmallInteger(d + 6)
      local step = readSmallInteger(d + 8)
      local xp = 0
      for l = 1, maxLevel - 1 do xp = xp + base + step * (l - 1) end
      writeBytes(e + 2, maxLevel)
      if readSmallInteger(e + 4) &lt; xp then writeSmallInteger(e + 4, xp) end
    end
  end
end
{$asm}

[DISABLE]</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1400</ID>
          <Description>"Unlock every action command - movement, defence and reprisals (includes other characters' moves: if one misbehaves, unequip it; back up your save, tick once)"</Description>
          <Color>40D040</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local stock = getAddress('"KINGDOM HEARTS Birth by Sleep FINAL MIX.exe"+111B5048')
local data = getAddress('"KINGDOM HEARTS Birth by Sleep FINAL MIX.exe"+A07020')
local wanted = {248,249,250,251,252,253,254,255,256,257,258,259,260,261,262,263,264,265,266,267,268,269,270,271,272,273,274,275,276,277,278,279,280,281,282}
local owned, free = {}, {}
for i = 0, 568 do
  local e = stock + i * 10
  local id = readSmallInteger(e)
  if id == 0 then free[#free + 1] = e else owned[id] = true end
end
local added = 0
for _, id in ipairs(wanted) do
  if not owned[id] then
    local e = free[added + 1]
    if e == nil then
      showMessage('Command stock is full - added ' .. added .. ' commands.')
      return
    end
    local level = 0
    if readBytes(data + id * 30 + 5) &gt; 0 then level = 1 end
    writeSmallInteger(e, id)
    writeBytes(e + 2, level, 0)
    writeSmallInteger(e + 4, 0)
    writeSmallInteger(e + 6, 0)
    writeBytes(e + 8, 0, 0)
    added = added + 1
  end
end
showMessage('Added ' .. added .. ' commands. Open the command deck menu to equip them.')
{$asm}

[DISABLE]</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1401</ID>
          <Description>"Unlock every shotlock (includes other characters' shotlocks - back up your save, tick once)"</Description>
          <Color>40D040</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local stock = getAddress('"KINGDOM HEARTS Birth by Sleep FINAL MIX.exe"+111B5048')
local data = getAddress('"KINGDOM HEARTS Birth by Sleep FINAL MIX.exe"+A07020')
local wanted = {284,285,286,287,288,289,290,291,292,293,294,295,296,297,299,300,301}
local owned, free = {}, {}
for i = 0, 568 do
  local e = stock + i * 10
  local id = readSmallInteger(e)
  if id == 0 then free[#free + 1] = e else owned[id] = true end
end
local added = 0
for _, id in ipairs(wanted) do
  if not owned[id] then
    local e = free[added + 1]
    if e == nil then
      showMessage('Command stock is full - added ' .. added .. ' commands.')
      return
    end
    local level = 0
    if readBytes(data + id * 30 + 5) &gt; 0 then level = 1 end
    writeSmallInteger(e, id)
    writeBytes(e + 2, level, 0)
    writeSmallInteger(e + 4, 0)
    writeSmallInteger(e + 6, 0)
    writeBytes(e + 8, 0, 0)
    added = added + 1
  end
end
showMessage('Added ' .. added .. ' commands. Open the command deck menu to equip them.')
{$asm}

[DISABLE]</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1402</ID>
          <Description>"Unlock every battle command the character you are playing can use - attacks, magic and items, with 50 of each item (back up your save, tick once)"</Description>
          <Color>40D040</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local stock = getAddress('"KINGDOM HEARTS Birth by Sleep FINAL MIX.exe"+111B5048')
local data = getAddress('"KINGDOM HEARTS Birth by Sleep FINAL MIX.exe"+A07020')
local finishers = getAddress('"KINGDOM HEARTS Birth by Sleep FINAL MIX.exe"+111B71F4')
local who = ({[61] = 'V', [62] = 'A', [63] = 'T'})[readSmallInteger(finishers)]
if who == nil then
  showMessage('Could not tell which character is loaded. Load a save first, then tick this again.')
  return
end
local only = {
  [94] = 'T', [97] = 'T', [99] = 'T', [100] = 'T', [110] = 'T', [122] = 'T', [125] = 'T',
  [126] = 'T', [128] = 'T', [129] = 'T', [134] = 'T', [165] = 'T', [173] = 'T', [175] = 'T',
  [103] = 'V', [104] = 'V', [105] = 'V', [111] = 'V', [121] = 'V', [124] = 'V', [166] = 'V',
  [174] = 'V', [112] = 'VA',
  [93] = 'A', [107] = 'A', [114] = 'A', [136] = 'A', [141] = 'A', [145] = 'A', [152] = 'A',
  [159] = 'A', [160] = 'A', [161] = 'A', [168] = 'A', [169] = 'A', [170] = 'A', [171] = 'A'
}
local owned, free = {}, {}
for i = 0, 568 do
  local e = stock + i * 10
  local id = readSmallInteger(e)
  if id == 0 then free[#free + 1] = e else owned[id] = true end
end
local added, full = 0, false
for id = 91, 196 do
  local o = only[id]
  if not owned[id] and (o == nil or o:find(who, 1, true)) then
    local e = free[added + 1]
    if e == nil then
      full = true
      break
    end
    local level = 0
    if readBytes(data + id * 30 + 5) &gt; 0 then level = 1 end
    writeSmallInteger(e, id)
    writeBytes(e + 2, level, 0)
    writeSmallInteger(e + 4, 0)
    writeSmallInteger(e + 6, 0)
    writeBytes(e + 8, 0, 0)
    added = added + 1
  end
end
-- for item commands (188-196) the level byte is how many you own
for i = 0, 568 do
  local e = stock + i * 10
  local id = readSmallInteger(e)
  if id &gt;= 188 and id &lt;= 196 and readBytes(e + 2) &lt; 50 then writeBytes(e + 2, 50) end
end
local msg = 'Added ' .. added .. ' battle commands and set your items to 50. Open the command deck menu to equip them.'
if full then msg = 'Command stock is full - ' .. msg end
showMessage(msg)
{$asm}

[DISABLE]</AssemblerScript>
        </CheatEntry>

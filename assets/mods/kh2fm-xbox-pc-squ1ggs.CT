    <CheatEntry>
      <ID>2000</ID>
      <Description>"Gummi Ship"</Description>
      <Options moHideChildren="1" moManualExpandCollapse="1" moAllowManualCollapseAndExpand="1"/>
      <Color>00C0FF</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>2050</ID>
          <Description>"During a gummi mission (tick to turn on, untick to turn off)"</Description>
          <Options moHideChildren="1" moManualExpandCollapse="1" moAllowManualCollapseAndExpand="1"/>
          <Color>00C0FF</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
        <CheatEntry>
          <ID>2001</ID>
          <Description>"Infinite gummi ship HP (refills after every hit - one hit bigger than your whole HP bar can still destroy you, use god mode below for that)"</Description>
          <Color>00C0FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if kh2GummiHp then kh2GummiHp.destroy() end
local hp = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+29AC0C8')
kh2GummiHp = createTimer(nil, false)
kh2GummiHp.Interval = 20
kh2GummiHp.OnTimer = function()
  local m = readInteger(hp + 4)
  local v = readFloat(hp)
  if m and v and m &gt; 0 and m &lt; 100000 and v &gt; 0 and v &lt; m then writeFloat(hp, m) end
end
kh2GummiHp.Enabled = true
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if kh2GummiHp then kh2GummiHp.destroy() kh2GummiHp = nil end
{$asm}
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>2002</ID>
          <Description>"Gummi ship god mode - holds HP at 99999 so even huge hits cannot destroy you (experimental - the HP bar may look odd, untick to go back to normal)"</Description>
          <Color>00C0FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if kh2GummiGod then kh2GummiGod.destroy() end
local hp = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+29AC0C8')
kh2GummiGod = createTimer(nil, false)
kh2GummiGod.Interval = 20
kh2GummiGod.OnTimer = function()
  local v = readFloat(hp)
  if v and v &gt; 0 and v &lt; 99999 then writeFloat(hp, 99999) end
end
kh2GummiGod.Enabled = true
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if kh2GummiGod then kh2GummiGod.destroy() kh2GummiGod = nil end
local hp = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+29AC0C8')
local m = readInteger(hp + 4)
local v = readFloat(hp)
if m and v and m &gt; 0 and v &gt; m then writeFloat(hp, m) end
{$asm}
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>2003</ID>
          <Description>"Medals never drop when you get hit (keeps berserk going in medal missions)"</Description>
          <Color>00C0FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if kh2GummiMedal then kh2GummiMedal.destroy() end
local sc = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+92A0B0')
local md = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+92A244')
local lastScore, best
kh2GummiMedal = createTimer(nil, false)
kh2GummiMedal.Interval = 20
kh2GummiMedal.OnTimer = function()
  local s, m = readInteger(sc), readInteger(md)
  if not s or not m then return end
  if lastScore == nil or s &lt; lastScore then best = m end
  if m &lt; best then writeInteger(md, best) else best = m end
  lastScore = s
end
kh2GummiMedal.Enabled = true
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if kh2GummiMedal then kh2GummiMedal.destroy() kh2GummiMedal = nil end
{$asm}
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>2004</ID>
          <Description>"Score and medal multiplier - tick, then set the multipliers below (2 = double, 1 = off)"</Description>
          <Options moHideChildren="1"/>
          <Color>00C0FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
alloc(kh2GummiMult,8)
registersymbol(kh2GummiMult)
kh2GummiMult:
dd 2
dd 2
{$lua}
if syntaxcheck then return end
if kh2GummiMultTimer then kh2GummiMultTimer.destroy() end
local sc = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+92A0B0')
local md = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+92A244')
local lastS, lastM
kh2GummiMultTimer = createTimer(nil, false)
kh2GummiMultTimer.Interval = 20
kh2GummiMultTimer.OnTimer = function()
  local mult = getAddressSafe('kh2GummiMult')
  local s, m = readInteger(sc), readInteger(md)
  if not mult or not s or not m then return end
  if lastS == nil or s &lt; lastS then lastS, lastM = s, m return end
  local sm, mm = readInteger(mult), readInteger(mult + 4)
  if s &gt; lastS and sm and sm &gt; 1 then
    s = math.min(lastS + (s - lastS) * sm, 99999999)
    writeInteger(sc, s)
  end
  if m &gt; lastM and mm and mm &gt; 1 then
    m = math.min(lastM + (m - lastM) * mm, 999)
    writeInteger(md, m)
  end
  if not (kh2GummiMedal and m &lt; lastM) then lastM = m end
  lastS = s
end
kh2GummiMultTimer.Enabled = true
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if kh2GummiMultTimer then kh2GummiMultTimer.destroy() kh2GummiMultTimer = nil end
{$asm}
unregistersymbol(kh2GummiMult)
dealloc(kh2GummiMult)
</AssemblerScript>

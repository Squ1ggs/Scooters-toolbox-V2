        <CheatEntry>
          <ID>1291</ID>
          <Description>"Shields (Goofy)"</Description>
          <Options moHideChildren="1" moManualExpandCollapse="1" moAllowManualCollapseAndExpand="1"/>
          <Color>D0D000</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>1270</ID>
              <Description>"Give one of every shield - tick once"</Description>
              <Color>40D040</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local save = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+BC4770')
local soraLevel = readBytes(save + 0x24FF)
if soraLevel == nil or soraLevel &lt; 1 or soraLevel &gt; 99 then
  showMessage('Load your save in the game first, then tick this again.')
  error('no save loaded')
end
local function atLeast(slot, n)
  local a = save + 0x3580 + slot
  if readBytes(a) &lt; n then writeBytes(a, n) end
end
local function setBit(bit)
  local a = save + 0x36C0 + bit // 8
  writeBytes(a, readBytes(a) | (1 &lt;&lt; (bit % 8)))
end
local function giveAbilities(list, firstSlot, lastSlot)
  local have, free = {}, {}
  for i = firstSlot, lastSlot do
    local v = readSmallInteger(list + i * 2) &amp; 0x7FFF
    if v == 0 then free[#free + 1] = i else have[v] = true end
  end
  return function(ids)
    local added, skipped = 0, 0
    for _, id in ipairs(ids) do
      if not have[id] then
        if #free &gt; 0 then
          writeSmallInteger(list + table.remove(free, 1) * 2, id)
          have[id] = true
          added = added + 1
        else
          skipped = skipped + 1
        end
      end
    end
    return added, skipped
  end
end
for _, slot in ipairs({41, 102, 103, 104, 105, 106, 107, 108, 109, 110, 254, 275, 289, 290, 291, 292, 293, 294, 295, 311}) do atLeast(slot, 1) end
showMessage('Done - you have every shield. Open and close the pause menu.')
{$asm}

[DISABLE]
</AssemblerScript>

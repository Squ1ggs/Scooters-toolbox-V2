        <CheatEntry>
          <ID>2020</ID>
          <Description>"Gummi blocks &amp; abilities (works anywhere once a save is loaded - reopen the ship editor to see changes)"</Description>
          <Options moHideChildren="1" moManualExpandCollapse="1" moAllowManualCollapseAndExpand="1"/>
          <Color>00C0FF</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>2047</ID>
              <Description>"Give every gummi block x99 + one of each ability + max cost &amp; AP limit upgrades (clean abilities list, no Dummy abilities). Reopen the ship editor to see it. Untick to put your old counts back"</Description>
              <Color>00C0FF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local save = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+BC4770')
local lv = readBytes(save + 0x24FF, 1)
if not lv or lv &lt; 1 or lv &gt; 99 then error('Load a save first') end
kh2GummiCleanBackup = readBytes(save + 0x10E00, 0x138, true)
local t = {}
for i = 1, 0x138 do t[i] = (i &lt;= 0xB8 or i &gt; 0xF4) and 99 or 1 end
for _, slot in ipairs({0xD1, 0xD2, 0xD3, 0xD4, 0xD9, 0xE1, 0xE2, 0xF2}) do t[slot + 1] = 0 end
for _, slot in ipairs({0xB8, 0xBF, 0xC0, 0xC1, 0xC2, 0xC4, 0xC5, 0xC6, 0xC7, 0xC8, 0xC9, 0xCA, 0xCB, 0xCC, 0xCD}) do t[slot + 1] = 99 end
writeBytes(save + 0x10E00, t)
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if kh2GummiCleanBackup then
  writeBytes(getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+BC4770') + 0x10E00, kh2GummiCleanBackup)
  kh2GummiCleanBackup = nil
end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>2048</ID>
              <Description>"Unlock every ship blueprint (Highwind, Falcon &amp; Invincible Lv. 1-8 and Peak - earns the all-blueprints achievement once you enter a gummi mission)"</Description>
              <Color>00C0FF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local save = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+BC4770')
local lv = readBytes(save + 0x24FF, 1)
if not lv or lv &lt; 1 or lv &gt; 99 then error('Load a save first') end
local t = readBytes(save + 0x10F32, 0x1E, true)
for i = 1, #t do
  if t[i] == 0 and i ~= 0x14 and i ~= 0x1E then t[i] = 1 end
end
writeBytes(save + 0x10F32, t)
{$asm}

[DISABLE]
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>2021</ID>
              <Description>"Max every gummi block you already own to 99"</Description>
              <Color>00C0FF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local save = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+BC4770')
local lv = readBytes(save + 0x24FF, 1)
if not lv or lv &lt; 1 or lv &gt; 99 then error('Load a save first') end
local blocks = readBytes(save + 0x10E00, 0xCE, true)
for i = 1, #blocks do
  local slot = i - 1
  local unused = (slot &gt;= 0xB9 and slot &lt;= 0xBE) or slot == 0xC3
  if not unused and blocks[i] &gt; 0 and blocks[i] &lt; 99 then blocks[i] = 99 end
end
writeBytes(save + 0x10E00, blocks)
{$asm}

[DISABLE]
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>2022</ID>
              <Description>"Old version - sets every slot to 99 (not recommended: the abilities list fills up with copies and Dummy entries. Use the script at the top of this group instead). Untick to put your old counts back"</Description>
              <Color>00C0FF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local save = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+BC4770')
local lv = readBytes(save + 0x24FF, 1)
if not lv or lv &lt; 1 or lv &gt; 99 then error('Load a save first') end
kh2GummiBlockBackup = readBytes(save + 0x10E00, 0x138, true)
local blocks = {}
for i = 1, 0x138 do blocks[i] = 99 end
writeBytes(save + 0x10E00, blocks)
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if kh2GummiBlockBackup then
  writeBytes(getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+BC4770') + 0x10E00, kh2GummiBlockBackup)
  kh2GummiBlockBackup = nil
end
{$asm}
</AssemblerScript>

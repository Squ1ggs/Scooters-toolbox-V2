    <CheatEntry>
      <ID>99</ID>
      <Description>"For KINGDOM HEARTS II FINAL MIX - Xbox PC / Microsoft Store version (2026). Attach Cheat Engine to KINGDOM HEARTS II FINAL MIX.exe. Does not work on the Steam or Epic versions."</Description>
      <Color>FF8000</Color>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
    <CheatEntry>
      <ID>1001</ID>
      <Description>"Back up your save first. Load your save, and it's usually best to make edits while the pause menu is open - close and reopen it afterwards to see changes. Gummi items show up after you reopen the ship editor. Ticked scripts only need ticking once."</Description>
      <Color>0000FF</Color>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
    <CheatEntry>
      <ID>101</ID>
      <Description>"WARNING: Avoid heavily levelling Roxas before becoming Sora. Doing so may cause Donald and Goofy to miss moves/abilities because they are not active party members during the Roxas section. Back up your save before using XP edits. (Missed them already? Use the Donald / Goofy give-ability scripts below.)"</Description>
      <Color>0000FF</Color>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
    <CheatEntry>
      <ID>1900</ID>
      <Description>"Combat cheats (tick to turn on, untick to turn off)"</Description>
      <Options moHideChildren="1" moManualExpandCollapse="1" moAllowManualCollapseAndExpand="1"/>
      <Color>4080FF</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>1901</ID>
          <Description>"Infinite HP - Sora (a single huge hit can still knock you out)"</Description>
          <Color>4080FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if kh2HpSora then kh2HpSora.destroy() end
local sora = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+2C3DA58')
local party = {sora - 0x278, sora - 0x4F0}
kh2HpSora = createTimer(nil, false)
kh2HpSora.Interval = 50
kh2HpSora.OnTimer = function()
  local m = readInteger(sora + 4)
  local v = readInteger(sora)
  if m and v and m &gt; 0 and v &gt; 0 and v &lt; m then writeInteger(sora, m) end
end
kh2HpSora.Enabled = true
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if kh2HpSora then kh2HpSora.destroy() kh2HpSora = nil end
{$asm}
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1902</ID>
          <Description>"Infinite HP - Donald, Goofy or whoever is in your party"</Description>
          <Color>4080FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if kh2HpParty then kh2HpParty.destroy() end
local sora = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+2C3DA58')
local party = {sora - 0x278, sora - 0x4F0}
kh2HpParty = createTimer(nil, false)
kh2HpParty.Interval = 50
kh2HpParty.OnTimer = function()
  for _, a in ipairs(party) do
    local m = readInteger(a + 4)
    local v = readInteger(a)
    if m and v and m &gt; 0 and v &gt; 0 and v &lt; m then writeInteger(a, m) end
  end
end
kh2HpParty.Enabled = true
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if kh2HpParty then kh2HpParty.destroy() kh2HpParty = nil end
{$asm}
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1903</ID>
          <Description>"Infinite MP - Sora and party"</Description>
          <Color>4080FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if kh2Mp then kh2Mp.destroy() end
local sora = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+2C3DA58')
local party = {sora - 0x278, sora - 0x4F0}
kh2Mp = createTimer(nil, false)
kh2Mp.Interval = 50
kh2Mp.OnTimer = function()
  for _, a in ipairs({sora, party[1], party[2]}) do
    local m = readInteger(a + 0x184)
    local v = readInteger(a + 0x180)
    if m and v and m &gt; 0 and v &lt; m then writeInteger(a + 0x180, m) end
  end
end
kh2Mp.Enabled = true
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if kh2Mp then kh2Mp.destroy() kh2Mp = nil end
{$asm}
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1904</ID>
          <Description>"Infinite drive gauge - drive bars stay full"</Description>
          <Color>4080FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if kh2Drive then kh2Drive.destroy() end
local sora = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+2C3DA58')
local party = {sora - 0x278, sora - 0x4F0}
kh2Drive = createTimer(nil, false)
kh2Drive.Interval = 50
kh2Drive.OnTimer = function()
  local max = readBytes(sora + 0x1B2)
  if max and max &gt; 0 then
    if readBytes(sora + 0x1B1) &lt; max then writeBytes(sora + 0x1B1, max) end
    if readBytes(sora + 0x1B0) &lt; 100 then writeBytes(sora + 0x1B0, 100) end
  end
end
kh2Drive.Enabled = true
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if kh2Drive then kh2Drive.destroy() kh2Drive = nil end
{$asm}
</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
    <CheatEntry>
      <ID>102</ID>
      <Description>"Sora - stats"</Description>
      <Options moHideChildren="1" moManualExpandCollapse="1" moAllowManualCollapseAndExpand="1"/>
      <Color>FF80C0</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>1016</ID>
          <Description>"Max Sora's slots and drive gauge (4 armor, 4 accessory, 8 item slots, 9 drive bars) - tick once"</Description>
          <Color>40D040</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local save = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+BC4770')
local soraLevel = readBytes(save + 0x24FF)
if soraLevel == nil or soraLevel &lt; 1 or soraLevel &gt; 99 then
  showMessage('Load your save in the game first, then tick this again.')
  error('no save loaded')
end
local function atLeast(slot, n)
  local a = save + 0x3580 + slot
  if readBytes(a) &lt; n then writeBytes(a, n) end
end
local function setBit(bit)
  local a = save + 0x36C0 + bit // 8
  writeBytes(a, readBytes(a) | (1 &lt;&lt; (bit % 8)))
end
local function giveAbilities(list, firstSlot, lastSlot)
  local have, free = {}, {}
  for i = firstSlot, lastSlot do
    local v = readSmallInteger(list + i * 2) &amp; 0x7FFF
    if v == 0 then free[#free + 1] = i else have[v] = true end
  end
  return function(ids)
    local added, skipped = 0, 0
    for _, id in ipairs(ids) do
      if not have[id] then
        if #free &gt; 0 then
          writeSmallInteger(list + table.remove(free, 1) * 2, id)
          have[id] = true
          added = added + 1
        else
          skipped = skipped + 1
        end
      end
    end
    return added, skipped
  end
end
local s = save + 0x24F0
writeBytes(s + 0x10, 4, 4, 8)
writeBytes(save + 0x3529, 9, 9)
local live = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+2C3DA58')
writeBytes(live + 0x1B1, 9, 9)
showMessage('Sora now has 4 armor, 4 accessory and 8 item slots, and 9 full drive bars. Open and close the pause menu.')
{$asm}

[DISABLE]
</AssemblerScript>

for i = 0, 4 do writeBytes(save + 0x32F4 + i * 0x38 + 2, 7) end
for _, g in ipairs({{0x25CE, 32865}, {0x25D0, 32869}, {0x25D2, 33335}, {0x25D4, 32873}, {0x25D6, 32877}}) do writeSmallInteger(save + g[1], g[2]) end

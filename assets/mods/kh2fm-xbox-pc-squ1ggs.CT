        <CheatEntry>
          <ID>2060</ID>
          <Description>"Ship editor (values only show while the ship editor is open)"</Description>
          <Options moHideChildren="1" moManualExpandCollapse="1" moAllowManualCollapseAndExpand="1"/>
          <Color>00C0FF</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
        <CheatEntry>
          <ID>2040</ID>
          <Description>"Hold higher cost &amp; AP limits - tick, then set the limits below (only ever raises them)"</Description>
          <Options moHideChildren="1" />
          <Color>00C0FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
alloc(kh2GummiCost,8)
registersymbol(kh2GummiCost)
kh2GummiCost:
dd #50000
dd #99
{$lua}
if syntaxcheck then return end
if kh2GummiCostTimer then kh2GummiCostTimer.destroy() end
local exe = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"')
kh2GummiCostTimer = createTimer(nil, false)
kh2GummiCostTimer.Interval = 50
kh2GummiCostTimer.OnTimer = function()
  local lim = getAddressSafe('kh2GummiCost')
  local ed = readQword(exe + 0xD17C70)
  local s = readQword(exe + 0xD17858)
  if not lim or not ed or ed == 0 or not s or s ~= ed + 0x23C8 or readQword(s) ~= exe + 0x76EEB8 then return end
  local wantCost, wantAp = readInteger(lim), readInteger(lim + 4)
  local cost = readInteger(s + 0xC)
  if wantCost and cost and cost &gt; 0 and cost &lt; wantCost then writeInteger(s + 0xC, wantCost) end
  local ap = readInteger(ed + 0x858)
  if wantAp and ap and ap &gt; 0 and ap &lt; wantAp then writeInteger(ed + 0x858, wantAp) end
end
kh2GummiCostTimer.Enabled = true
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if kh2GummiCostTimer then kh2GummiCostTimer.destroy() kh2GummiCostTimer = nil end
{$asm}
unregistersymbol(kh2GummiCost)
dealloc(kh2GummiCost)</AssemblerScript>

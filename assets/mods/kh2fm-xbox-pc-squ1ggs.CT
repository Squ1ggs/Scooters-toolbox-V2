      <ID>1329</ID>
      <Description>"Drive Forms &amp; Growth Abilities"</Description>
      <Options moHideChildren="1" moManualExpandCollapse="1" moAllowManualCollapseAndExpand="1"/>
      <Color>FF80FF</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>1301</ID>
          <Description>"Unlock all five drive forms (Valor, Wisdom, Limit, Master, Final) - also gives Valor, Master and Final a keyblade if they have none, which stops the game crashing when you drive. Tick once"</Description>
          <Color>40D040</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local save = getAddress('"KINGDOM HEARTS II FINAL MIX.exe"+BC4770')
local soraLevel = readBytes(save + 0x24FF)
if soraLevel == nil or soraLevel &lt; 1 or soraLevel &gt; 99 then
  showMessage('Load your save in the game first, then tick this again.')
  error('no save loaded')
end
local function atLeast(slot, n)
  local a = save + 0x3580 + slot
  if readBytes(a) &lt; n then writeBytes(a, n) end
end
local function setBit(bit)
  local a = save + 0x36C0 + bit // 8
  writeBytes(a, readBytes(a) | (1 &lt;&lt; (bit % 8)))
end
local function giveAbilities(list, firstSlot, lastSlot)
  local have, free = {}, {}
  for i = firstSlot, lastSlot do
    local v = readSmallInteger(list + i * 2) &amp; 0x7FFF
    if v == 0 then free[#free + 1] = i else have[v] = true end
  end
  return function(ids)
    local added, skipped = 0, 0
    for _, id in ipairs(ids) do
      if not have[id] then
        if #free &gt; 0 then
          writeSmallInteger(list + table.remove(free, 1) * 2, id)
          have[id] = true
          added = added + 1
        else
          skipped = skipped + 1
        end
      end
    end
    return added, skipped
  end
end
for _, bit in ipairs({1, 2, 83, 6, 4}) do setBit(bit) end
-- Valor, Master and Final fight with a second keyblade - a form with none crashes the game when you drive
local fixed = 0
for _, off in ipairs({0x32F4, 0x339C, 0x33D4}) do
  if readSmallInteger(save + off) == 0 then
    writeSmallInteger(save + off, 41)
    fixed = fixed + 1
  end
end
local msg = 'All five drive forms are unlocked. Drive forms need Donald and Goofy (or a world party member) in your party.'
if fixed &gt; 0 then msg = msg .. ' ' .. fixed .. ' form(s) had no keyblade, so they now use the Kingdom Key - change it in the pause menu if you like.' end
showMessage(msg)
{$asm}

[DISABLE]
</AssemblerScript>
